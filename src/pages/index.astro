---
import BaseHead from "../components/BaseHead.astro"
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts"

import Header from "@components/Navbar/Navbar"
import HorizontalLine from "@components/HorizointalLine"
import SocialLinks from "@components/SocialLinks"
import { ProjectContainer } from "@components/ProjectContainer"
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="text-left mt-10">
			<!-- Personal Intro -->
			<section>
				<h1 class="text-4xl mb-3">Hello! My name is Kyle.</h1>
				<p>
					I'm a recent graduate from the University of California,
					Irvine. I like making websites. This website serves as my
					portfolio and my blog. As of now, I plan to post my leetcode
					solutions and development logs of my personal projects.
					Thank you for visiting.
				</p>

				<SocialLinks />
			</section>

			<!-- Horizontal Line -->
			<div class="mt-3 mb-8">
				<HorizontalLine />
			</div>

			<!-- Experience -->
			<section>
				<h2 class="text-3xl font-semibold">Experience</h2>

				<!-- Algoup Inc. -->
				<ProjectContainer
					title="Algoup Frontend Developer Intern"
					repoLink="https://github.com/KyleHu14/algoup"
					blogLink="/blog/watchface/"
					description="A website built for an autonomous robot startup."
				/>

				<!-- Boundary RSS -->
				<ProjectContainer
					title="Boundary RSS Frontend Developer"
					repoLink="https://github.com/KyleHu14/boundary-rss"
					blogLink="/blog/watchface/"
					description="A website built for an environmental organization."
				/>

				<!-- Watchface -->
				<ProjectContainer
					title="Watchface Research Assistant"
					repoLink="https://github.com/pielab-uci/watchface-website"
					blogLink="/blog/watchface/"
					description="A website built for a research project at UCI."
				/>
			</section>

			<!-- Personal Projects -->
			<section class="mt-[2rem]">
				<h2 class="text-3xl font-semibold">Personal Projects</h2>

				<!-- Job Tracker -->
				<ProjectContainer
					title="Job Tracker"
					repoLink="https://github.com/KyleHu14/job-tracker"
					blogLink="/blog/job-tracker/"
					description="A website that can track your job applications."
				/>
			</section>
		</main>
	</body>
</html>

<style>
	ul {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
	}
</style>
