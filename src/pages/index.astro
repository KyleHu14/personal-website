---
import BaseHead from "../components/BaseHead.astro"
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts"

import Header from "@components/Navbar/Navbar"
import HorizontalLine from "@components/HorizointalLine"
import SocialLinks from "@components/SocialLinks"
import ProjectLink from "@components/ProjectLink"
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="text-left mt-10">
			<div class="text-4xl mb-3">Hello! My name is Kyle.</div>
			<p>
				I'm a recent graduate from the University of California, Irvine.
				I like making websites. This website serves as my portfolio and
				my blog. As of now, I plan to post my leetcode solutions and
				development logs of my personal projects. Thank you for
				visiting.
			</p>

			<SocialLinks />

			<div class="mt-3 mb-8">
				<HorizontalLine />
			</div>

			<!-- prettier-ignore -->
			<div class="projects">
					<div class="text-3xl mb-5">Experience</div>
					<div class="text-2xl">Job Tracker | <ProjectLink link="https://github.com/KyleHu14/job-tracker" text="Repo"/> | <ProjectLink link="/blog/job-tracker/" text="Blog"/></div>
					<p>
						A website that can track your job applications.
					</p>

					<div class="text-2xl">Watchface | <ProjectLink link="https://github.com/pielab-uci/watchface-website" text="Repo"/> | <ProjectLink link="/blog/watchface/" text="Blog"/></div>
					<p>
						A website built for a research project at UCI.
					</p>
				</div>
		</main>
	</body>
</html>

<style>
	ul {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
	}
</style>
